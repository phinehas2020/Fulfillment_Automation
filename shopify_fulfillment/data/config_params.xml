    <!-- Amazon Buy Shipping is intentionally safe-off until a private SP-API
         app has the Direct-to-Consumer Shipping role and a read-only rate test
         succeeds. Secrets are injected via process environment or admin-only
         ir.config_parameter records; they are never exposed in the general
         fulfillment configuration wizard.

         amazon_shipping.enabled = False
         amazon_shipping.lwa_client_id
         amazon_shipping.lwa_client_secret
         amazon_shipping.refresh_token
         amazon_shipping.endpoint = https://sellingpartnerapi-na.amazon.com
         amazon_shipping.business_id = AmazonShipping_US
         amazon_shipping.marketplace_id = ATVPDKIKX0DER
         amazon_shipping.required_vas_preferences = {}

         Structured-rate guardrails:
         fulfillment.max_rate_premium_absolute = 25.00
         fulfillment.max_rate_premium_percent = 50
         fulfillment.shipping_service_policy_map = JSON mapping checkout titles
             to stable service_ids/carrier_ids/max_estimated_days.
    -->
</odoo>
